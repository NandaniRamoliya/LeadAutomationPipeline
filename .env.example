# =====================================================================
#  Orbit by Indrix: secrets. Easiest: fill these in the dashboard
#  (Settings → Setup → "Your email"); it writes this file for you.
#  NEVER commit .env to git (it is in .gitignore).
# =====================================================================

# ---- Main sending mailbox (use a SEPARATE domain, e.g. getyourstudio.com) ----
# Examples:  FROM_EMAIL=you@getyourstudio.com   FROM_NAME=Your Name
FROM_EMAIL=
FROM_NAME=
# REPLY_TO=

# Google Workspace / Gmail: smtp.gmail.com, 587, starttls, App Password (Google Account > Security > App passwords)
# Microsoft 365: smtp.office365.com, 587, starttls      Zoho: smtp.zoho.in (or .com), 465, ssl
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=

# ---- Reading replies (same mailbox) ----
# Gmail: imap.gmail.com 993 | Microsoft 365: outlook.office365.com 993 | Zoho: imap.zoho.in 993
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Folders to scan, comma separated (Gmail spam folder: [Gmail]/Spam)
IMAP_FOLDERS=INBOX

# ---- Extra mailboxes (config.yaml → mailboxes) read their passwords from here ----
# MAILBOX2_PASSWORD=

# ---- AI (optional). Without it, built-in templates are used. ----
# Claude API key from console.anthropic.com. Or leave empty and log in to the `claude` CLI to use your Claude plan.
ANTHROPIC_API_KEY=

# ---- Optional lead sources ----
SERPER_API_KEY=
GOOGLE_PLACES_API_KEY=
HUNTER_API_KEY=

# ---- Alerts (optional) ----
NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Dashboard ----
# Required if the dashboard is reachable from the network (phone / server / Docker). Username can be anything.
DASHBOARD_PASSWORD=
# Long random string used to sign unsubscribe links and sessions (generated automatically if empty)
LEADPIPE_SECRET=
# Secret for the calendar webhook: POST https://your-domain/webhooks/booking?token=THIS (Cal.com / Calendly)
BOOKING_WEBHOOK_TOKEN=
